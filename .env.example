# ── AnonChat configuration ──────────────────────────────────────────────────
# All configuration is via environment variables. Copy to `.env` for local dev.
# No values here are secrets — there is nothing persisted and no DB credentials.

# Port the server binds to. Coolify injects PORT automatically.
# The server always binds 0.0.0.0:$PORT.
PORT=8080

# Maximum number of members allowed in a single room (spec: 10).
MAX_ROOM_SIZE=10

# How long a room may sit with no activity before it is destroyed and its
# RAM wiped. Go duration syntax (e.g. 30s, 5m, 1h). Empty/0 disables idle GC.
ROOM_IDLE_TIMEOUT=30m

# Comma-separated list of allowed Origin header values for the WebSocket
# handshake (CSRF / cross-site WS protection). Use "*" to allow any origin
# (development only — do NOT use "*" in production). Example:
#   ALLOWED_ORIGINS=https://chat.example.com,https://www.example.com
ALLOWED_ORIGINS=*

# Trust X-Forwarded-* headers from a reverse proxy (Coolify/Traefik).
# Set to true only when running behind a trusted proxy.
TRUST_PROXY=false

# Lifetime of a single-use invite code before it expires (Go duration).
# (Used from Phase 4 onward.)
INVITE_CODE_TTL=5m

# ── Rate limiting (basic abuse protection) ──────────────────────────────────
# Max room-creation requests per source IP per minute.
RATE_LIMIT_CREATE_PER_MIN=10
# Max invite-code redemption attempts per source IP per minute.
RATE_LIMIT_REDEEM_PER_MIN=20

# ── Logging ─────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Log format: text | json
LOG_FORMAT=text
